<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexModelSwitcher</AssemblyName>
    <RootNamespace>CodexModelSwitcher</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 版本號同時寫入執行檔內容，使用者可於檔案內容的詳細資料頁確認版本。 -->
    <Version>0.9.0</Version>
    <Product>Codex Model Switcher</Product>
    <AssemblyTitle>Codex 多模型切換器</AssemblyTitle>
    <Description>Windows 可攜版 Codex 多模型切換器</Description>
    <Authors>Zell Huang</Authors>
    <Copyright>Copyright (c) 2026 Zell Huang. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests 底下的原始碼由 tests/CodexModelSwitcher.Tests.csproj 自行編譯，不得納入主程式。 -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
